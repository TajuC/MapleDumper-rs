/target
**/*.rs.bk
.vs/
.vscode/
*.pdb
/hdr.txt
/offsets.h
/update.txt

# Tauri build-time generated ACL/permission schemas
crates/maple-app/gen/

# Public docs live under docs/; the local-only documentation suite stays off the remote.
docs/*
!docs/ARCHITECTURE.md
!docs/CROSS_VERSION_BASELINE.md
!docs/THIRD-PARTY-LICENSES.md

# Local-only scratch prompts and notes (kept off the remote)
/mapledumper_*_prompt.md
/MAPLEDUMPER_*_PROMPT.md
/*.scratch.md

# Local-only audit artifacts and numbered review notes (kept off the remote)
/audit-output.zip
/audit-output/
/[0-9]*-*.md

# Local-only design mockups, release staging, and agent config (kept off the remote)
/vision/
/reldist/
.claude/
